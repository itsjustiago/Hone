<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>Hone</string>
    <key>CFBundleIdentifier</key>
    <string>com.tiagof.hone</string>
    <key>CFBundleName</key>
    <string>Hone</string>
    <key>CFBundleDisplayName</key>
    <string>Hone</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.6.0</string>
    <key>CFBundleVersion</key>
    <string>8</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- Menu bar agent: no Dock icon, no main window on launch. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Soundly (per-app volume): Core Audio process taps need the
         "System Audio Recording" permission. Asked only when the user first
         moves an app's slider off 100 %, never at launch. -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>O Soundly precisa de acesso ao áudio das apps para lhes ajustar o volume. O som nunca é gravado nem guardado.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Hone — a modular macOS power-tools suite.</string>
</dict>
</plist>
